+          if (ret < 0)
+            {
+              goto cancel;
+            }
 
           wkupevent = SDIO_EVENTWAIT(dev);
           ret = SDIO_RECVR5(dev, SD_ACMD53WR, &data);
         }
       else
         {
-          sdio_sendcmdpoll(dev, SD_ACMD53WR, arg.value);
+          ret = sdio_sendcmdpoll(dev, SD_ACMD53WR, arg.value);
+          if (ret < 0)
+            {
+              goto cancel;
+            }
+
           ret = SDIO_RECVR5(dev, SD_ACMD53WR, &data);
+          if (ret < 0)
+            {
+              goto cancel;
+            }
+
+          ret = sdio_transfer_setup(dev, true, buf, blocklen * nblocks);
+          if (ret < 0)
+            {
+              goto cancel;
+            }
 
-          SDIO_DMASENDSETUP(dev, buf, blocklen * nblocks);
           wkupevent = SDIO_EVENTWAIT(dev);
