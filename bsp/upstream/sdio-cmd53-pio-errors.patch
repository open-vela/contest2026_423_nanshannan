     {
       return -EIO;
     }
@@ -243,9 +279,28 @@ int sdio_io_rw_extended(FAR struct sdio_dev_s *dev, bool write,
   union sdio_cmd5x arg;
   struct sdio_resp_r5 resp;
   uint32_t data;
