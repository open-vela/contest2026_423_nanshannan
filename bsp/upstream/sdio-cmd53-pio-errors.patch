+   */
+
+  if (dev == NULL || buf == NULL || function > 7 || address > 0x1ffff ||
+      blocklen == 0 || blocklen > 0xffff || nblocks > 511 ||
+      (nblocks == 0 && blocklen > 512))
+    {
+      return -EINVAL;
+    }
+
+  length = blocklen * (nblocks == 0 ? 1 : nblocks);
+  if (inc_addr && length > 0x20000 - address)
+    {
+      return -EINVAL;
+    }
+
   /* Setup CMD53 argument */
 
   arg.value = 0;
@@ -270,7 +325,11 @@ int sdio_io_rw_extended(FAR struct sdio_dev_s *dev, bool write,
       arg.cmd53.byte_block_count = nblocks;
     }
 
-  sdio_takelock(dev);
+  ret = sdio_takelock(dev);
+  if (ret < 0)
+    {
+      return ret;
+    }
 
   /* Send CMD53 command */
 
@@ -287,26 +346,58 @@ int sdio_io_rw_extended(FAR struct sdio_dev_s *dev, bool write,
 
