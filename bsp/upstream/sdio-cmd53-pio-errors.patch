+      if (ret < 0)
+        {
+          goto cancel;
+        }
+
+      ret = SDIO_SENDCMD(dev, SD_ACMD53RD, arg.value);
+      if (ret < 0)
+        {
+          goto cancel;
+        }
 
       wkupevent = SDIO_EVENTWAIT(dev);
       ret = SDIO_RECVR5(dev, SD_ACMD53RD, &data);
@@ -317,7 +408,7 @@ int sdio_io_rw_extended(FAR struct sdio_dev_s *dev, bool write,
 
   /* There may not be a response to this, so don't look for one */
 
-  SDIO_RECVR1(dev, SD_ACMD52ABRT, &data);
+  SDIO_RECVR1(dev, SD_ACMD52ABRT, &abort_response);
   sdio_givelock(dev);
 
   if (ret != OK)
@@ -336,7 +427,8 @@ int sdio_io_rw_extended(FAR struct sdio_dev_s *dev, bool write,
       return -ETIMEDOUT;
     }
 
-  if (resp.flags.error || (wkupevent & SDIOWAIT_ERROR))
+  if (resp.flags.error || resp.flags.com_crc_error ||
+      resp.flags.illegal_command || (wkupevent & SDIOWAIT_ERROR))
     {
       wlerr("error 1\n");
       return -EIO;
@@ -349,6 +441,11 @@ int sdio_io_rw_extended(FAR struct sdio_dev_s *dev, bool write,
     }
 
   return OK;
+
+cancel:
+  SDIO_CANCEL(dev);
+  sdio_givelock(dev);
+  return ret;
 }
 
 int sdio_set_wide_bus(FAR struct sdio_dev_s *dev)
@@ -384,10 +481,16 @@ int sdio_probe(FAR struct sdio_dev_s *dev)
   int ret;
   int bit;
   uint32_t data = 0;
+  uint32_t ocr;
+  clock_t start;
 
   nxmutex_init(&dev->mutex);
 
-  sdio_takelock(dev);
+  ret = sdio_takelock(dev);
+  if (ret < 0)
+    {
+      return ret;
+    }
 
   /* Set device state from reset to idle */
 
@@ -415,24 +518,58 @@ int sdio_probe(FAR struct sdio_dev_s *dev)
       goto err;
     }
 
-  /* Get the maximun and minimum values for VDD */
+  /* Only voltage bits may be used as the next CMD5 argument. A memory-only
+   * card or a response with no voltage window is not an SDIO function.
+   */
 
-  bit = ffs(data);
-  if (bit)
-    {
-      bit -= 1;
-      data &= 3 << bit;
-    }
-  else
+  ocr = data & SDIO_R4_VOLTAGES;
+  if (ocr == 0 || (data & SDIO_R4_FUNCTIONS) == 0)
     {
-      ret = -EINVAL;
+      ret = -ENODEV;
       goto err;
     }
 
-  ret = sdio_sendcmdpoll(dev, SDIO_CMD5, data);
-  if (ret != OK)
+  bit = ffs(ocr) - 1;
+  ocr &= 3u << bit;
+  start = clock_systime_ticks();
+
+  /* CMD0 above resets the card again, even when a board-level diagnostic
+   * already observed READY. Read every R4 and do not request an RCA until
+   * this initialization sequence has completed.
+   */
+
+  for (; ; )
     {
-      goto err;
+      if (clock_systime_ticks() - start >= MSEC2TICK(SDIO_READY_TIMEOUT_MS))
+        {
+          ret = -ETIMEDOUT;
+          goto err;
+        }
+
+      ret = sdio_sendcmdpoll(dev, SDIO_CMD5, ocr);
+      if (ret != OK)
+        {
+          goto err;
+        }
+
+      ret = SDIO_RECVR4(dev, SDIO_CMD5, &data);
+      if (ret != OK)
+        {
+          goto err;
+        }
+
+      if ((data & SDIO_R4_FUNCTIONS) == 0 || (data & ocr) == 0)
+        {
+          ret = -ENODEV;
+          goto err;
+        }
+
+      if ((data & SDIO_R4_READY) != 0)
+        {
+          break;
+        }
+
+      nxsig_usleep(SDIO_READY_POLL_US);
     }
 
