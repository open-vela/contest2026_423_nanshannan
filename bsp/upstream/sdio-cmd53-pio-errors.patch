 /****************************************************************************
  * Private Types
@@ -167,6 +173,21 @@ static int sdio_sendcmdpoll(FAR struct sdio_dev_s *dev,
   return ret;
 }
 
+static int sdio_transfer_setup(FAR struct sdio_dev_s *dev, bool write,
+                               FAR uint8_t *buffer, size_t length)
+{
+#ifdef CONFIG_SDIO_DMA
+  if ((SDIO_CAPABILITIES(dev) & SDIO_CAPS_DMASUPPORTED) != 0)
+    {
+      return write ? SDIO_DMASENDSETUP(dev, buffer, length) :
+                     SDIO_DMARECVSETUP(dev, buffer, length);
+    }
+#endif
+
+  return write ? SDIO_SENDSETUP(dev, buffer, length) :
+                 SDIO_RECVSETUP(dev, buffer, length);
+}
+
 /****************************************************************************
  * Public Functions
  ****************************************************************************/
@@ -180,6 +201,11 @@ int sdio_io_rw_direct(FAR struct sdio_dev_s *dev, bool write,
