@@ -40,6 +41,11 @@
 
 #define SDIO_CMD53_TIMEOUT_MS 1000
 #define SDIO_IDLE_DELAY_MS    50
+#define SDIO_READY_TIMEOUT_MS 1000
+#define SDIO_READY_POLL_US    10000
+#define SDIO_R4_READY         (1u << 31)
