+/****************************************************************************
+ * Name: usbhost_xhci_platform_init
+ *
+ * Description:
+ *   Initialize a memory-mapped xHCI controller (see xhci_pci.h).
+ *
+ ****************************************************************************/
+
+int usbhost_xhci_platform_init(uintptr_t base, int irq)
+{
+  FAR struct usbhost_conn_xhci_s *conn;
+  FAR struct usbhost_xhci_s      *priv;
+  int                             ret;
+
+  conn = kmm_zalloc(sizeof(struct usbhost_conn_xhci_s));
+  priv = kmm_zalloc(sizeof(struct usbhost_xhci_s));
+  if (conn == NULL || priv == NULL)
+    {
+      kmm_free(conn);
+      kmm_free(priv);
+      return -ENOMEM;
+    }
+
+  conn->conn.wait      = xhci_wait;
+  conn->conn.enumerate = xhci_enumerate;
+  conn->priv           = priv;
+
+  priv->base = base;
+  priv->irq  = irq;
+
+  ret = xhci_probe_common(priv, conn);
+  if (ret < 0)
+    {
+      /* Don't leave the handler attached to freed state */
+
+      xhci_oper_putreg(priv, XHCI_USBCMD, 0);
+      up_disable_irq(irq);
+      irq_detach(irq);
+      kmm_free(conn);
+      kmm_free(priv);
+    }
+
+  return ret;
+}
+#endif
