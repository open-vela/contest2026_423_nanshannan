+/****************************************************************************
+ * Name: xhci_dev_get
+ *
+ * Description:
+ *   Get the device that owns an endpoint, NULL if the endpoint is not
+ *   bound to a device slot (yet).
+ *
+ ****************************************************************************/
+
+static FAR struct xhci_dev_s *xhci_dev_get(FAR struct usbhost_xhci_s *priv,
+                                           FAR struct xhci_epinfo_s *epinfo)
+{
+  if (epinfo == NULL || epinfo->slot == 0 || epinfo->slot > priv->no_slots)
+    {
+      return NULL;
+    }
+
+  return &priv->devs[epinfo->slot - 1];
+}
+
+/****************************************************************************
+ * Name: xhci_root_port
+ *
+ * Description:
+ *   Get the root hub port below which a hub port is located.
+ *
+ ****************************************************************************/
+
+static FAR struct xhci_rhport_s *
+xhci_root_port(FAR struct usbhost_xhci_s *priv,
+               FAR struct usbhost_hubport_s *hport)
+{
+#ifdef CONFIG_USBHOST_HUB
+  while (!ROOTHUB(hport))
+    {
+      hport = hport->parent;
+    }
+#endif
+
+  return &priv->rhport[hport->port];
+}
+
+/****************************************************************************
+ * Name: xhci_speed_id
+ *
+ * Description:
+ *   Convert USB speed to the xHCI Protocol Speed ID (default mapping).
+ *
+ ****************************************************************************/
+
+static uint8_t xhci_speed_id(uint8_t speed)
+{
+  switch (speed)
+    {
+      case USB_SPEED_LOW:
+        return XHCI_PORTSC_PS_LOW;
+
+      case USB_SPEED_HIGH:
+        return XHCI_PORTSC_PS_HIGH;
+
+      case USB_SPEED_SUPER:
+      case USB_SPEED_SUPER_PLUS:
+        return XHCI_PORTSC_PS_SUPPER11;
+
+      default:
+        return XHCI_PORTSC_PS_FULL;
+    }
+}
