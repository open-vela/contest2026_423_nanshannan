+#ifdef CONFIG_USBHOST_HUB
+/****************************************************************************
+ * Name: xhci_hub_update
+ *
+ * Description:
+ *   Tell the xHC that a device is a hub, once its hub descriptor is known.
+ *   Configure Endpoint with only the Slot Context added evaluates the Hub,
+ *   Number of Ports and TTT fields.
+ *
+ * Reference:
+ *   - 4.6.6: Configure Endpoint
+ *
+ ****************************************************************************/
+
+static int xhci_hub_update(FAR struct usbhost_xhci_s *priv,
+                           FAR struct xhci_dev_s *dev,
+                           FAR const uint8_t *hubdesc)
+{
+  FAR struct xhci_slot_ctx_s *slot = &dev->input->slot;
+  uint16_t                    chars;
+  uint32_t                    regval;
+
+  chars = hubdesc[3] | (hubdesc[4] << 8);
+
+  /* Keep Context Entries as the xHC has them */
+
+  up_invalidate_dcache((uintptr_t)dev->ctx,
+                       (uintptr_t)dev->ctx + sizeof(struct xhci_dev_ctx_s));
+
+  regval  = le32toh(slot->ctx[0]) & ~XHCI_ST_CTX0_CTXENT_MASK;
+  regval |= le32toh(dev->ctx->slot.ctx[0]) & XHCI_ST_CTX0_CTXENT_MASK;
+  regval |= XHCI_ST_CTX0_HUB;
+  slot->ctx[0] = htole32(regval);
+
+  regval  = le32toh(slot->ctx[1]) & ~XHCI_ST_CTX1_PORTS_MASK;
+  regval |= XHCI_ST_CTX1_PORTS_SET(hubdesc[2]);
+  slot->ctx[1] = htole32(regval);
+
+  if (dev->hport->speed == USB_SPEED_HIGH)
+    {
+      regval  = le32toh(slot->ctx[2]) & ~XHCI_ST_CTX2_TTT_MASK;
+      regval |= XHCI_ST_CTX2_TTT_SET((chars >> 5) & 3);
+      slot->ctx[2] = htole32(regval);
+    }
+
+  dev->input->input.ctx[0] = 0;
+  dev->input->input.ctx[1] = htole32(XHCI_IN_CTX1_A(XHCI_SLOT_FLAG));
+
+  up_flush_dcache((uintptr_t)dev->input,
+                  (uintptr_t)dev->input +
+                  sizeof(struct xhci_input_dev_ctx_s));
+
+  return xhci_cmd_cfgep(priv, dev->slot,
+                        up_addrenv_va_to_pa(dev->input), false);
+}
+#endif
