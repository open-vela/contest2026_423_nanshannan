@@ -0,0 +1,38 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/* zblue 的 arch_interface.h / irq.h / spinlock.h 会 #undef CONFIG_SMP，让 zephyr
+ * 自己的代码走单核路径（互斥靠 arch_irq_lock() 里的 enter_critical_section()）。
+ *
+ * 但 NuttX 的头是在第一次被包含时按 CONFIG_SMP 选实现的：undef 之后才第一次
+ * 包含的话，NuttX 是 SMP 内核，这些头却按单核展开：
+ *   this_task()              -> g_readytorun.head（就绪队列的头，不是当前任务）
+ *   sched_lock()/unlock()    -> 改的是别的任务的 lockcount
+ *   enter_critical_section() -> 只关本核中断，挡不住其他核
+ *   gettid()                 -> 读错 TCB
+ * 所以在 undef 之前把它们按 SMP 先包含一遍，include guard 保证之后不再重新展开。
+ */
+
+#ifndef ZEPHYR_INCLUDE_ARCH_POSIX_NUTTX_SMP_H_
+#define ZEPHYR_INCLUDE_ARCH_POSIX_NUTTX_SMP_H_
+
+#include <nuttx/config.h>
+
+#ifdef CONFIG_SMP
+#include <sys/types.h>
+#include <sched.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <nuttx/percpu.h>
+#include <nuttx/spinlock_type.h>
+#include <nuttx/spinlock.h>
+#include <nuttx/seqlock.h>
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+#include <nuttx/sched.h>
+#include <nuttx/sched_note.h>
+#include <nuttx/pthread.h>
+#endif
+
+#endif /* ZEPHYR_INCLUDE_ARCH_POSIX_NUTTX_SMP_H_ */
