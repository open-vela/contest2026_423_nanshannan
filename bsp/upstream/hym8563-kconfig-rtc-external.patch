+config RTC_HYM8563
+	bool "Haoyu HYM8563 I2C RTC"
+	default n
+	select I2C
+	select RTC_DATETIME
+	depends on RTC_EXTERNAL
+	---help---
+		Haoyu HYM8563 I2C 实时时钟。
+
+		★ 秒寄存器 bit7 是掉电标志（VL），置位表示走时曾中断、
