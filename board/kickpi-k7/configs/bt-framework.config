# 叠加在 amp-dual 上：蓝牙换成 openvela 框架（frameworks/connectivity/bluetooth）
# + zblue 协议栈，SKW6621S 的 HCI 以 /dev/ttyHCI0 交给框架。
#
# 与 NuttX 自带的蓝牙 host（btsak / bnep0）不能共存：两套协议栈不能同时
# 占用一个 HCI。这里把自带 host 关掉；设置页的蓝牙扫描在这份配置下不可用。
#
# 框架用 SOCKET_IPC（与 goldfish-armeabi-v7a-ap 一致）：bluetoothd 是服务，
# bttool 经本地 socket 连它。LOCAL 模式在上游编不过：service/src/scan_manager.c
# 无条件调 bt_socket_server_is_busy()，而 socket 部分只在 SOCKET_IPC 下编译。
# 双模（BR/EDR + LE 都走 zblue，与 sf32lb52 参考配置一致）：上游框架和 zblue
# 的纯 LE 组合多处编不过（sal_adapter_interface.c 的 BR 函数、att.c 的 br_chan）。
# unqlite 存储（要文件锁：FS_LOCK_BUCKET_SIZE > 0）。
# zblue 的角色要自己开：默认只有 BROADCASTER，扫描要 OBSERVER（CENTRAL 带上）。
#
# CONFIG_WIRELESS_BLUETOOTH is not set
# CONFIG_NET_BLUETOOTH is not set
CONFIG_UART_BTH4=y
CONFIG_FS_LOCK_BUCKET_SIZE=4
CONFIG_UNQLITE=y
CONFIG_BLUETOOTH=y
CONFIG_BLUETOOTH_FRAMEWORK=y
CONFIG_BLUETOOTH_FRAMEWORK_SOCKET_IPC=y
CONFIG_NET_LOCAL=y
CONFIG_NET_LOCAL_SCM=y
CONFIG_BLUETOOTH_SERVER=y
CONFIG_BLUETOOTH_IPC_JOIN_LOOP=y
CONFIG_BLUETOOTH_BREDR_SUPPORT=y
CONFIG_BLUETOOTH_STACK_BREDR_ZBLUE=y
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_BLUETOOTH_BLE_SUPPORT=y
CONFIG_BLUETOOTH_BLE_SCAN=y
CONFIG_BLUETOOTH_BLE_ADV=y
CONFIG_BLUETOOTH_LE_ADVERTISER_MAX_NUM=1
CONFIG_BLUETOOTH_SERVICE=y
CONFIG_BLUETOOTH_STACK_LE_ZBLUE=y
CONFIG_BLUETOOTH_STORAGE_UNQLITE_SUPPORT=y
CONFIG_BLUETOOTH_SERVICE_HCI_UART_NAME="/dev/ttyHCI0"
CONFIG_BLUETOOTH_TOOLS=y
CONFIG_BT=y
CONFIG_BT_H4=y
CONFIG_BT_UART_ON_DEV_NAME="/dev/ttyHCI0"
CONFIG_BT_GATT_CLIENT=y
CONFIG_BT_GATT_DYNAMIC_DB=y
CONFIG_BT_DEVICE_NAME_DYNAMIC=y
CONFIG_BT_CENTRAL=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_SMP=y
CONFIG_BT_MAX_CONN=2
CONFIG_BT_MAX_PAIRED=4
CONFIG_BT_HCI_TX_STACK_SIZE_WITH_PROMPT=y
CONFIG_BT_CLASSIC=y
# 下面两项与所有参考配置一致：GATT_CACHING 在本版 zblue 里编不过（多控制器改造没改完）
# CONFIG_BT_GATT_CACHING is not set
CONFIG_BT_POWER_MODE_CONTROL=y
CONFIG_BT_PRIVACY=y
# 框架日志（BT_LOG*）只在 BLUETOOTH_LOG 下才有；6 = INFO。
# log_server.c 不开 KVDB 编不过，补丁见 bsp/upstream/bt-framework-aarch64-build.patch
CONFIG_BLUETOOTH_LOG=y
CONFIG_BLUETOOTH_SERVICE_LOG_LEVEL=6
# zblue 线程栈是 .bss 里的静态数组（pthread_attr_setstack），没有保护页，溢出直接
# 写坏相邻的 k_work（内嵌 wdog_s）→ 内核 wdog 链表损坏。参考配置是 32 位的 4096，
# aarch64 指针翻倍，统一放大；实际用量用 ps 看（STACK_COLORATION）。
CONFIG_BT_HCI_TX_STACK_SIZE=16384
CONFIG_BT_RX_STACK_SIZE=16384
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=16384
CONFIG_BLUETOOTH_SERVICE_LOOP_THREAD_STACK_SIZE=16384
# bluetoothd 主线程在 h4_open() 里调 open(/dev/ttyHCI0)，SKW 的厂商初始化
# （发命令、下 NV）在调用者栈上跑：单独从 nsh 打开实测就用掉 4.8KB。叠在
# bluetoothd 自身初始化调用链上，默认 8KB 会溢出，压坏堆上相邻对象。
CONFIG_BLUETOOTH_TASK_STACK_SIZE=32768
# 多核同时打日志会逐字符交错，开行缓冲才看得清蓝牙各线程的日志
CONFIG_SYSLOG_BUFFER=y
# 试验：libuv 改用 poll 后端（epoll 后端下 bttool 客户端线程在 file_poll 里拿到坏的 filep）
# CONFIG_LIBUV_BACKEND_EPOLL is not set

# 调试：dumpstack <pid> 打出任务的回溯（卡住时查在等什么）
CONFIG_SYSTEM_DUMPSTACK=y

# zblue 的 prng_init() = psa_crypto_init()，熵来自 getrandom(flags=0)，NuttX 的
# getrandom 读 /dev/urandom。没有这个节点时 psa_crypto_init 失败，bt_init 返回 -EIO，
# 适配器停在 TURNING_ON 且没有任何报错。ARCH：/dev/urandom 与 /dev/random 是同一个
# 硬件 RNG（rk3576_rng.c 自检通过后才注册）。
CONFIG_DEV_URANDOM=y
CONFIG_DEV_URANDOM_ARCH=y
