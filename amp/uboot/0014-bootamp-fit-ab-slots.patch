+ * openvela 镜像的 A/B 槽（仓库 amp/include/k7_bootab.h，这里抄一份结构，
+ * 两边改一处就要改另一处）。
+ *
+ *   救援 FIT  trust 分区 AMP_FIT_LBA，flash.sh 写的那一份
+ *   控制块    LBA 32760 / 32761 两份，按 seq 的奇偶轮流写
+ *   A/B 槽    recovery 分区（LBA 182272，96MB），每槽 32MB，槽里直接是 FIT
+ *
+ * 选槽规则照搬 openvela frameworks/system/ota 的 bootctl_boot()：
+ *   active + bootable 但还没 successful 的槽 → 置 try，试启动；
+ *   下次进来 try 还在 → 那次试启动没被确认（openvela 侧 `bootctl`），作废，
+ *   回到 successful 的槽；
+ *   都没有 → 救援 FIT。
+ * 在上游规则之外多做两件事：
+ *   - 启动前就用 fit_all_image_verify() 校验槽里的 FIT。brought_up_all_amp()
+ *     先拉起 Linux 再加载 openvela，到那时才发现哈希不对就晚了（A72 已经
+ *     在跑，不能再换一个槽重来）。所以校验必须在这里、在任何核起来之前。
+ *   - 试启动作废时清 try。上游这里不清，下一次升级写完 bootctl done 之后，
+ *     新槽会因为 try 还在被直接判为"试启动失败"，根本没试。
+ *
+ * 控制块两份都无效（从没做过 OTA，或 flash.sh 刚清过）= 没有 A/B，直接用
+ * 救援 FIT，和没有这一段时完全一样。`setenv amp_ab off` 也走这条路。
+ */
+#define K7AB_MAGIC		"K7ABCTRL"
+#define K7AB_VERSION		1
+#define K7AB_CTRL_LBA		32760
+#define K7AB_PART_LBA		182272
+#define K7AB_SLOT_SECTORS	65536
+#define K7AB_SLOT_A		2048
+#define K7AB_SLOT_B		(K7AB_SLOT_A + K7AB_SLOT_SECTORS)
+#define K7AB_BOOTED_NONE	0xff
+#define K7AB_SLOT_LBA(i)	(K7AB_PART_LBA + ((i) ? K7AB_SLOT_B : K7AB_SLOT_A))
+#define K7AB_HDR_SECTORS	16		/* 8KB：FIT 的 FDT 部分（-p 0xe00） */
+
+/* 控制块读写缓冲：FIT 窗口（0x60000000 起，最多 32MB）下方 1MB */
+#define AMP_AB_BUF		0x5ff00000
+
+struct k7ab_slot_s {
+	u8	active;
+	u8	bootable;
+	u8	successful;
+	u8	reserved;
+	u32	length;
+	u8	sha256[32];
+};
+
+struct k7ab_ctrl_s {
+	char	magic[8];
+	u32	version;
+	u32	seq;
+	u8	try_boot;
+	u8	booted;
+	u8	boot_count;
+	u8	reserved;
+	struct k7ab_slot_s slot[2];
+	u32	crc32;
+};
