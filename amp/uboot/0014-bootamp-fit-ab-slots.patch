+/* ---- A/B ---- */
+
+static u32 ab_crc(const struct k7ab_ctrl_s *c)
+{
+	return crc32(0, (const u8 *)c, offsetof(struct k7ab_ctrl_s, crc32));
+}
+
+static bool ab_valid(const struct k7ab_ctrl_s *c)
+{
+	return !memcmp(c->magic, K7AB_MAGIC, 8) &&
+	       c->version == K7AB_VERSION && c->crc32 == ab_crc(c);
+}
+
+static int ab_read(struct blk_desc *d, struct k7ab_ctrl_s *c)
+{
+	struct k7ab_ctrl_s *p0 = (void *)AMP_AB_BUF;
+	struct k7ab_ctrl_s *p1 = (void *)(AMP_AB_BUF + 512);
+	bool v0, v1;
+
+	if (blk_dread(d, K7AB_CTRL_LBA, 2, (void *)AMP_AB_BUF) != 2)
+		return -EIO;
+
+	v0 = ab_valid(p0);
+	v1 = ab_valid(p1);
+	if (!v0 && !v1)
+		return -ENOENT;
+
+	/* seq 用差值比较，回绕也对 */
+	memcpy(c, v0 && (!v1 || (int)(p0->seq - p1->seq) > 0) ? p0 : p1,
+	       sizeof(*c));
+	return 0;
+}
+
+static int ab_write(struct blk_desc *d, struct k7ab_ctrl_s *c)
+{
+	c->seq++;
+	c->crc32 = ab_crc(c);
+	memset((void *)AMP_AB_BUF, 0, 512);
+	memcpy((void *)AMP_AB_BUF, c, sizeof(*c));
+
+	/* seq 为偶数写第 0 份、奇数写第 1 份，另一份保留上一个状态 */
+	if (blk_dwrite(d, K7AB_CTRL_LBA + (c->seq & 1), 1,
+		       (void *)AMP_AB_BUF) != 1)
+		return -EIO;
+	return 0;
+}
+
+/* 返回要启动的槽（0 = A，1 = B），-1 表示用救援 FIT */
+static int ab_pick(struct k7ab_ctrl_s *c)
+{
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		struct k7ab_slot_s *s = &c->slot[i];
+
+		if (!s->active || !s->bootable || s->successful)
+			continue;
+
+		if (c->try_boot) {
+			printf("AMP: 槽 %c 上次试启动没有被确认，作废\n",
+			       'A' + i);
+			s->active = 0;
+			s->bootable = 0;
+			c->try_boot = 0;
+			break;
+		}
+
+		c->try_boot = 1;
+		c->boot_count++;
+		printf("AMP: 槽 %c 尚未确认，试启动（第 %u 次）\n",
+		       'A' + i, c->boot_count);
+		return i;
+	}
+
+	for (i = 0; i < 2; i++)
+		if (c->slot[i].active && c->slot[i].successful)
+			return i;
+
+	for (i = 0; i < 2; i++) {
+		if (c->slot[i].successful) {
+			c->slot[i].active = 1;
+			c->slot[i].bootable = 1;
+			return i;
+		}
+	}
+
+	return -1;
+}
+
+/* 把槽里的 FIT 读到 AMP_FIT_ADDR 并校验全部镜像的哈希 */
+static int ab_load_slot(int i)
+{
+	void *fit = (void *)AMP_FIT_ADDR;
+	ulong lba = K7AB_SLOT_LBA(i);
+	ulong need, t0 = get_timer(0);
+	char cmd[128];
+
+	snprintf(cmd, sizeof(cmd), "mmc read 0x%x 0x%lx 0x%x",
+		 AMP_FIT_ADDR, lba, K7AB_HDR_SECTORS);
+	if (run_command(cmd, 0))
+		return -EIO;
+
+	if (fdt_check_header(fit) ||
+	    fdt_totalsize(fit) > K7AB_HDR_SECTORS * 512) {
+		printf("AMP: 槽 %c（LBA 0x%lx）不是 FIT\n", 'A' + i, lba);
+		return -EINVAL;
+	}
+
+	need = amp_fit_need(fit);
+	if (need > (ulong)K7AB_SLOT_SECTORS * 512) {
+		printf("AMP: 槽 %c 的 FIT 声称 %lu 字节，超过槽大小\n",
+		       'A' + i, need);
+		return -E2BIG;
+	}
+
+	snprintf(cmd, sizeof(cmd), "mmc read 0x%x 0x%lx 0x%lx",
+		 AMP_FIT_ADDR, lba, (need + 511) / 512);
+	if (run_command(cmd, 0))
+		return -EIO;
+
+	if (!fit_all_image_verify(fit)) {
+		printf("AMP: 槽 %c 的 FIT 哈希校验失败\n", 'A' + i);
+		return -EBADMSG;
+	}
+
+	printf("AMP: 槽 %c 的 FIT %lu 字节，哈希一致（读+校验 %lu ms）\n",
+	       'A' + i, need, get_timer(t0));
+	return 0;
+}
+
+static int amp_load_rescue_fit(void)
+{
+	char cmd[128];
+	int ret;
+
+	snprintf(cmd, sizeof(cmd), "mmc read 0x%x 0x%x 0x%x",
+		 AMP_FIT_ADDR, AMP_FIT_LBA, AMP_FIT_CNT);
+	ret = run_command(cmd, 0);
+	if (ret)
+		return ret;
+
+	return amp_check_fit_window((void *)(ulong)AMP_FIT_ADDR,
+				    (ulong)AMP_FIT_CNT * 512);
+}
+
+static int amp_load_openvela_fit(void)
+{
+	struct k7ab_ctrl_s c, orig;
+	struct blk_desc *d;
+	const char *env = env_get("amp_ab");
+	int n, slot, ret;
+
+	if (env && !strcmp(env, "off")) {
+		printf("AMP: A/B 已由 amp_ab=off 关闭，启动救援 FIT\n");
+		return amp_load_rescue_fit();
+	}
+
+	d = blk_get_dev("mmc", 0);
+	ret = d ? ab_read(d, &c) : -ENODEV;
+	if (ret) {
+		printf("AMP: 没有 A/B 控制块（%d），启动救援 FIT\n", ret);
+		return amp_load_rescue_fit();
+	}
+
+	orig = c;
+	printf("AMP: A/B seq %u：A[%c%c%c] B[%c%c%c] try=%u\n", c.seq,
+	       c.slot[0].active ? 'a' : '-', c.slot[0].bootable ? 'b' : '-',
+	       c.slot[0].successful ? 's' : '-',
+	       c.slot[1].active ? 'a' : '-', c.slot[1].bootable ? 'b' : '-',
+	       c.slot[1].successful ? 's' : '-', c.try_boot);
+
+	/* 每轮要么启动成功返回，要么作废一个槽；两轮之后必然收敛 */
+	for (n = 0; n < 3; n++) {
+		slot = ab_pick(&c);
+		if (slot < 0)
+			break;
+
+		ret = ab_load_slot(slot);
+		if (!ret) {
+			c.booted = slot;
+			if (memcmp(&c, &orig, sizeof(c)) && ab_write(d, &c))
+				printf("AMP: ★ 控制块写失败，照常启动\n");
+			return 0;
+		}
+
+		printf("AMP: 槽 %c 作废（%d）\n", 'A' + slot, ret);
+		c.slot[slot].active = 0;
+		c.slot[slot].bootable = 0;
+		c.slot[slot].successful = 0;
+		c.try_boot = 0;
+	}
+
+	c.booted = K7AB_BOOTED_NONE;
+	if (memcmp(&c, &orig, sizeof(c)) && ab_write(d, &c))
+		printf("AMP: ★ 控制块写失败\n");
+	printf("AMP: A/B 没有可用的槽，启动救援 FIT\n");
+	return amp_load_rescue_fit();
+}
