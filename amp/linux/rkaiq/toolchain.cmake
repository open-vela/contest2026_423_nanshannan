# glibc 工具链（与内核同一套 gcc-arm-10.3 aarch64-none-linux-gnu）
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER   $ENV{TC}gcc)
set(CMAKE_CXX_COMPILER $ENV{TC}g++)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# buildroot 默认带这两个；aiq_dumpRkRaw.c 用 mmap64，不带就是隐式声明报错
set(CMAKE_C_FLAGS_INIT   "-D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64")
set(CMAKE_CXX_FLAGS_INIT "-D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64")
