# A72 上 Linux 的摄像头链（第三步）：imx415 -> csi2_dphy3 -> mipi3_csi2
# -> rkcif -> rkisp(vir2) -> rkvpss。叠在 amp-rootfs.config 之上，
# build-rootfs.sh 一并合进去。
#
# ★ 驱动全部编成模块，.ko 放进 lxroot 镜像（amp/include/k7_lxroot.h），
#   不放进 Image。
#
#   Image 只能放在 LBA 49152 起的 7.25MB 窗口里（rkdeveloptool 写不到 32MB
#   以上），带内嵌 initramfs 已经 7.02MB。V4L2 + rkcif + rkisp + rkvpss
#   直接编进去必然超窗口。lxroot 是 U-Boot 读进来的外部 cpio，大小上限
#   384MB，模块和 rkaiq 的用户态放在一起。
#
# ★ IOMMU 打开以后，dtb 里每个 status = "okay" 的 iommu 节点都会被探测、
#   被复位。rk3576-kickpi-k7.dtsi 原本把 vop_mmu 等一串都开着，以前没事
#   只是因为 IOMMU_SUPPORT 是关的。amp dts 里把摄像头以外的全部关掉 ——
#   尤其 vop_mmu：屏幕归 openvela。

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_SUBDRV_AUTOSELECT=n
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_V4L_PLATFORM_DRIVERS=y

CONFIG_VIDEO_IMX415=m
CONFIG_PHY_ROCKCHIP_CSI2_DPHY=m
CONFIG_VIDEO_ROCKCHIP_CIF=m
CONFIG_VIDEO_ROCKCHIP_ISP=m
CONFIG_VIDEO_ROCKCHIP_VPSS=m

CONFIG_IOMMU_SUPPORT=y
CONFIG_ROCKCHIP_IOMMU=m

# 内核配置里开着好几个 CPU_*（厂商的通用配置），ISP 的这几个版本会被
# 默认选上；本板只有 V39，其余去掉，模块小一些。
CONFIG_VIDEO_ROCKCHIP_ISP_VERSION_V1X=n
CONFIG_VIDEO_ROCKCHIP_ISP_VERSION_V21=n
CONFIG_VIDEO_ROCKCHIP_ISP_VERSION_V30=n
CONFIG_VIDEO_ROCKCHIP_ISP_VERSION_V32=n
